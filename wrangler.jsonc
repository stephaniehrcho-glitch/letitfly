{
  // Cloudflare Worker for HitTheGrid: serves /public and the /api routes.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hitthegrid",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  // The D1 database keeps its original name, "letitfly".
  "routes": [
    { "pattern": "hitthegrid.app", "custom_domain": true },
    { "pattern": "www.hitthegrid.app", "custom_domain": true }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "letitfly",
      // Replace with the ID shown in Cloudflare → Storage & Databases → D1 → letitfly.
      "database_id": "70cedca9-46de-4fa7-adf8-c2a384bc1956",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "APP_NAME": "Hit The Grid",
    // Comma-separated emails that get the Director tab.
    "OWNER_EMAILS": "stephanie.hr.cho@gmail.com",
    // Sender for sign-in codes once Resend is set up, e.g. "HitTheGrid <login@hitthegrid.app>".
    "FROM_EMAIL": "Hit The Grid <login@hitthegrid.app>",
    // "1" shows sign-in codes on screen when no email service is configured. Testing only.
    "DEV_SHOW_CODES": "0"
  },
  // Live updates: one hub holds every open phone's connection and pushes changes.
  "durable_objects": {
    "bindings": [{ "name": "HUB", "class_name": "Hub" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Hub"] }],
  "observability": { "enabled": true }
}
